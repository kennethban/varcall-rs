// nf-core/sarek 3.12.0 with variant-rs: the GATK processes variant-rs runs use the variant-rs image, which also holds sarek's
// own GATK 4.7.0.0 (anything variant-rs does not reproduce exactly is handed to it, with the original arguments).
// Other GATK processes (CNNScoreVariants, FilterVariantTranches, GenomicsDBImport, VQSR, the Spark tools, ...)
// keep sarek's images.
//
//   nextflow run nf-core/sarek -r 3.12.0 -profile docker -c sarek_variant_rs.config ...
//
// HaplotypeCaller and Mutect2 use the GPU when the container gets one (Docker: --gpus all; Singularity /
// Apptainer: --nv) and the CPU otherwise, with the same output. Set params.variant_rs_gpu = false on hosts without
// NVIDIA's container runtime.
//
// CPUs: by default these tasks keep sarek's allocation (2 per task; MarkDuplicates 6; GenotypeGVCFs 1), sized for
// GATK, which uses little more than one core per task. variant-rs is multi-threaded and uses what the task is given:
// set params.variant_rs_cpus (e.g. --variant_rs_cpus 8) to give every variant-rs task that many CPUs. It is still capped by
// process.resourceLimits, and later configs (-c) override it.

// full name: sarek's docker profile prefixes names without a registry with quay.io/
params.variant_rs_container = 'docker.io/library/variant-rs:0.1.0-gatk4.7.0.0'
params.variant_rs_gpu       = true
params.variant_rs_cpus      = null   // null: sarek's CPU allocation

process {
    withName: 'GATK4_(MARKDUPLICATES|BASERECALIBRATOR|GATHERBQSRREPORTS|APPLYBQSR|HAPLOTYPECALLER|GENOTYPEGVCFS)|MERGE_(HAPLOTYPECALLER|GENOTYPEGVCFS|MUTECT2)|MUTECT2|MERGEMUTECTSTATS|(GET|GATHER)PILEUPSUMMARIES_(NORMAL|TUMOR)|CALCULATECONTAMINATION|LEARNREADORIENTATIONMODEL|FILTERMUTECTCALLS' {
        container = params.variant_rs_container
        // Docker: cap the container at the task's CPUs (variant-rs sizes its thread pool from the cgroup quota)
        containerOptions = { workflow.containerEngine == 'docker' ? "--cpus ${task.cpus}" : '' }
    }
    // CPUs: sarek's defaults (conf/base.config, the modules' labels) unless params.variant_rs_cpus is set. The three
    // selectors do not overlap: when several withName selectors match, the one Nextflow applies last wins, and that
    // order follows where sarek's own configs first declared a selector.
    withName: 'GATK4_(BASERECALIBRATOR|GATHERBQSRREPORTS|APPLYBQSR|HAPLOTYPECALLER)|MERGE_(HAPLOTYPECALLER|GENOTYPEGVCFS|MUTECT2)|MUTECT2|MERGEMUTECTSTATS|(GET|GATHER)PILEUPSUMMARIES_(NORMAL|TUMOR)|CALCULATECONTAMINATION|LEARNREADORIENTATIONMODEL|FILTERMUTECTCALLS' {
        cpus = { params.variant_rs_cpus ? params.variant_rs_cpus as int : 2 * task.attempt }
    }
    withName: 'GATK4_MARKDUPLICATES' {
        cpus = { params.variant_rs_cpus ? params.variant_rs_cpus as int : 6 * task.attempt }
    }
    withName: 'GATK4_GENOTYPEGVCFS' {
        cpus = { params.variant_rs_cpus ? params.variant_rs_cpus as int : 1 }
    }
    withName: 'GATK4_HAPLOTYPECALLER|MUTECT2' {
        containerOptions = {
            def cpu = workflow.containerEngine == 'docker' ? "--cpus ${task.cpus} " : ''
            cpu + (params.variant_rs_gpu ? (workflow.containerEngine in ['singularity', 'apptainer'] ? '--nv' : '--gpus all') : '')
        }
    }
}

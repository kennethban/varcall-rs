// variant-rs FASTQ -> VCF pipeline (main.nf). Run inside the environment that has samtools, htslib and Java for
// Nextflow (and bwa-mem2 for aligner = 'bwa-mem2': environment.yml has all of them), with variant-rs and align-rs built for this
// machine (RUSTFLAGS="-C target-cpu=native"; align-rs's CUDA kernels with make -C ../align-rs/cuda).

params {
    input               = null      // samplesheet CSV: patient,sample,status,lane,fastq_1,fastq_2 (step markduplicates: patient,sample,status,bam[,bai])
    step                = 'mapping' // mapping (from FASTQ) | markduplicates (from coordinate-sorted BAMs)
    outdir              = 'results'
    tools               = 'haplotypecaller'   // haplotypecaller, mutect2 (comma-separated)
    fasta               = null      // with .fai, .dict and the bwa-mem2 index beside it
    known_sites         = null      // BQSR known sites, comma-separated VCFs (dbSNP, Mills, known indels)
    intervals           = null      // HaplotypeCaller / Mutect2 -L (BED, interval_list or chr:from-to); BQSR is whole genome
    scatter_intervals   = 'auto'    // HaplotypeCaller: true = each interval its own GATK run (sarek's scatter), false = one run; auto: true for <= 1000 intervals
    hc_workers          = 0         // HaplotypeCaller contig workers (0: variant-rs default, min(threads/2, 8))
    dbsnp               = null      // HaplotypeCaller --dbsnp (ID column)
    gvcf                = false     // HaplotypeCaller -ERC GVCF (then no hard filters)
    germline_resource   = null      // Mutect2 --germline-resource (af-only gnomAD)
    pon                 = null      // Mutect2 -pon
    pileup_sites        = null      // GetPileupSummaries -V (common biallelic SNPs)
    pileup_on_intervals = false     // GetPileupSummaries -L the calling intervals instead of the sites VCF
    mutect2_normals     = true      // recalibrate normals for Mutect2 (needed for a matched normal)
    save_recal_bam      = false     // publish the somatic path's recalibrated BAMs
    save_lane_bams      = false     // publish the aligned, sorted lane BAMs
    variant_rs             = "${projectDir}/../target/release/variant-rs"
    aligner             = 'align-rs'  // align-rs (bwa-mem2's alignments on the GPU, sorted BAM + index directly) | bwa-mem2 (| samtools sort)
    align_rs              = "${projectDir}/../target/release/align-rs"
    pairhmm             = 'auto'    // auto (GPU when there is one) | cuda | cpu
    cpus                = 16        // threads for the heavy steps (each takes the machine to itself)
    align_memory        = '24 GB'   // the aligner maps the whole-genome index (~17 GB for hg38)
    publish_dir_mode    = 'link'
}

process {
    executor = 'local'
    cpus     = 2
    memory   = '4 GB'
    withLabel: 'heavy' {
        cpus   = { params.cpus }
        memory = '24 GB'
    }
}

executor {
    name = 'local'
}
trace {
    overwrite = true
    // start and cpus: for profile/report.py
    fields    = 'task_id,hash,name,status,exit,submit,start,complete,duration,realtime,cpus,%cpu,peak_rss,rchar,wchar'
}
